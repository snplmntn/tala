# Local development only. On Render these are dashboard env vars, never a file.
# Copy to .env (gitignored) and fill in. Keep comments on their own lines.

# BotFather -> /newbot
TELEGRAM_TOKEN=

# Your numeric Telegram id. The allowlist is this one value.
# To find it: set this to 0, run `npm run dev`, message the bot, read the log line
# "ignored update from <id>".
OWNER_CHAT_ID=

# console.groq.com/keys — free tier, no card
GROQ_API_KEY=

# turso db show tala --url
TURSO_URL=

# turso db tokens create tala
TURSO_TOKEN=
