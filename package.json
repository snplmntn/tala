{
  "name": "tala",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file=.env --watch src/index.ts",
    "migrate": "turso db shell $TURSO_DB < schema.sql",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "local": "node --env-file=.env src/index.ts",
    "chat": "node --env-file-if-exists=.env scripts/chat.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0"
  }
}
